# Copy settings into your private .env. Never commit real credentials.
LEARNER_ASSESSMENT_PROVIDER=deepseek
LEARNER_ASSESSMENT_API_ENABLED=false
LEARNER_ASSESSMENT_DEEPSEEK_API_KEY=
LEARNER_ASSESSMENT_DEEPSEEK_MODEL=
LEARNER_ASSESSMENT_OPENAI_API_KEY=
LEARNER_ASSESSMENT_OPENAI_MODEL=
LEARNER_ASSESSMENT_GEMINI_API_KEY=
LEARNER_ASSESSMENT_GEMINI_MODEL=
# University gateway: key from KKU API Platform; model ID/name from its model list.
LEARNER_ASSESSMENT_KKU_API_KEY=
LEARNER_ASSESSMENT_KKU_MODEL=
LEARNER_ASSESSMENT_API_TIMEOUT_SECONDS=240
LEARNER_ASSESSMENT_API_IDLE_TIMEOUT_SECONDS=60
LEARNER_ASSESSMENT_API_DAILY_LIMIT=20
LEARNER_ASSESSMENT_CONTEXT_TOKENS=12288
LEARNER_ASSESSMENT_OUTPUT_RESERVE_TOKENS=3072
LEARNER_ASSESSMENT_TOKEN_SAFETY_MARGIN=128
# Ollama remains available when explicitly selected; pin its reviewed digest.
LEARNER_ASSESSMENT_OLLAMA_URL=http://127.0.0.1:11434
LEARNER_ASSESSMENT_OLLAMA_MODEL_DIGEST=
